          "name": "Perforce Get Server Version",
          "request": {
            "name": "Perforce Get Server Version",
            "description": {
              "content": "Retrieves the installed Helix Swarm version, release year, and available API versions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "version"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The protocol scheme. (This can only be one of https,http)",
                  "type": "any",
                  "value": "{{scheme}}",
                  "key": "scheme"
                },
                {
                  "description": "The hostname of your Helix Swarm instance.",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "a46ed19d-1461-4bc5-8816-5980b77ac213",
              "name": "Server version information.",
              "originalRequest": {
                "url": {
                  "path": [
                    "version"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": [
                    {
